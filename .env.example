# 릴스 게시 도구용. 이 파일을 .env.publish 로 복사해서 채운다. (.env.publish 는 git에 올라가지 않는다)
# 게시 전용 토큰은 대시보드(Vercel)의 읽기 전용 토큰과 분리해서 새로 발급한다.
HOUSCAPER_IG_USER_ID=
HOUSCAPER_IG_PUBLISH_TOKEN=
TOPOGENESIS_IG_USER_ID=
TOPOGENESIS_IG_PUBLISH_TOKEN=

# 레딧 (광고: REDDIT_REFRESH_TOKEN+AD_ACCOUNT_ID, 글 반응: REDDIT_USER_REFRESH_TOKEN). 브랜드 전용 앱이면 {BRAND}_REDDIT_CLIENT_ID/SECRET
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
HOUSCAPER_REDDIT_USER_REFRESH_TOKEN=
TOPOGENESIS_REDDIT_USER_REFRESH_TOKEN=
# 틱톡 (developers.tiktok.com 앱, Redirect URI = {사이트}/api/tiktok/callback)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
HOUSCAPER_TIKTOK_REFRESH_TOKEN=
TOPOGENESIS_TIKTOK_REFRESH_TOKEN=
